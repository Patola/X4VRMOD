#version 450
// The shape of X4's FSR 1 pass (its fsr.comp.glsl, run as EASU then RCAS):
// an input render target read through a sampler (S_input_rt), an rgba16f
// storage image written by imageStore (U_output_rt), four uint4 constants
// (U_pass), 64 threads per workgroup each group covering a 16x16 tile, and a
// function named after the FSR stage. Written for the tests, not X4's code:
// the layer's compute instrument recognises a module by these names and
// reports where each resource is bound (take 379).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform Pass { uvec4 U_pass[4]; };
layout(set = 0, binding = 1) uniform sampler2D S_input_rt;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D U_output_rt;

vec4 FsrEasuH(ivec2 p) { return texelFetch(S_input_rt, p, 0); }

void main() {
    ivec2 p = ivec2(gl_WorkGroupID.xy) * 16 +
              ivec2(gl_LocalInvocationID.x % 8u, gl_LocalInvocationID.x / 8u);
    imageStore(U_output_rt, p, FsrEasuH(p) * float(U_pass[0].x));
}
