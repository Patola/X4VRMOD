#version 450
// The interface of X4's froxel fog walk (volume_walk.comp, one medium) as
// is_x4_volume_walk checks it: names and offsets only. X4's own module never enters this
// repository (it is copyrighted); this one only has the same interface.
#extension GL_ARB_enhanced_layouts : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 0, std140) uniform BLOCK_BUFFER_BINDING_SLOT_CAMERA {
    layout(offset = 128) mat4 M_invprojection;
    layout(offset = 512) mat4 M_viewinverse;
    layout(offset = 736) vec4 V_cameraposition;
    layout(offset = 784) vec4 V_lightcolor1;
    layout(offset = 960) vec4 V_volume_size;
    layout(offset = 1420) float F_time;
    layout(offset = 1528) float F_volume_off;
    layout(offset = 1532) float F_volume_scale;
};
layout(set = 4, binding = 0, std140) uniform BLOCK_BUFFER_BINDING_SLOT_DYNAMIC {
    layout(offset = 448) uint S_input_rt_idx[1];
    layout(offset = 464) uint S_output_rt_idx;
    layout(offset = 468) uint S_shad_idx;
};
layout(set = 0, binding = 6, rgba16f) uniform restrict writeonly image3D U_output_rt_decl[53306];
void main() {
    const float k = F_time + F_volume_off + F_volume_scale + V_cameraposition.x + V_lightcolor1.x +
                    M_invprojection[0][0] + M_viewinverse[0][0] + float(S_input_rt_idx[0] + S_shad_idx);
    imageStore(U_output_rt_decl[S_output_rt_idx], ivec3(gl_GlobalInvocationID), vec4(k) * V_volume_size);
}
