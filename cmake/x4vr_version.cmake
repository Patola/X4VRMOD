#
# Writes OUT (a one-function C++ source) with the version from
# `git describe --tags --always --dirty --match "v[0-9]*"`, run in SRC. Run at
# every build by the x4vr_version target; the file is rewritten only when the
# version changed, so an unchanged tree recompiles nothing. Without git (a
# source tarball) the version is X4VR_VERSION_FALLBACK.
execute_process(
    COMMAND git describe --tags --always --dirty --match "v[0-9]*"
    WORKING_DIRECTORY "${SRC}"
    OUTPUT_VARIABLE ver
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE rc
    ERROR_QUIET)
if(NOT rc EQUAL 0 OR ver STREQUAL "")
    set(ver "${X4VR_VERSION_FALLBACK}")
endif()
# The marker lets the launcher read a library's version from its file; it must
# never dlopen the layer or the injector, whose constructors would run.
set(body "// Generated by cmake/x4vr_version.cmake -- do not edit.
extern const char x4vr_version_marker[];
const char x4vr_version_marker[] = \"X4VRMOD_VERSION=${ver}\";
const char *x4vr_build_version() { return x4vr_version_marker + 16; }
")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL body)
    file(WRITE "${OUT}" "${body}")
endif()
