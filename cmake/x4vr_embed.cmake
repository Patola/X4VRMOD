#
# Writes OUT, a header with each file of FILES as an array of bytes:
#
#   cmake -DOUT=x.hpp "-DFILES=kArt=a.png;kWords=b.png" -P x4vr_embed.cmake
#
# For the layer's loading panel (launcher/art): the layer is one file inside X4's
# process and has nothing beside it to read pictures from. Plain CMake, so building
# needs no Python, Pillow or font; the pictures themselves are made and committed by
# tools/make_vr_loading.py.
set(body "// Generated by cmake/x4vr_embed.cmake -- do not edit.\n#pragma once\n#include <cstddef>\n")
foreach(pair IN LISTS FILES)
    string(FIND "${pair}" "=" eq)
    string(SUBSTRING "${pair}" 0 ${eq} name)
    math(EXPR from "${eq} + 1")
    string(SUBSTRING "${pair}" ${from} -1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND body "inline constexpr unsigned char ${name}[${bytes}] = {${arr}};\n")
endforeach()
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL body)
    file(WRITE "${OUT}" "${body}")
endif()
