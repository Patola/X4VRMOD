#: launcher/core/checks.cpp
#, qt-format
msgid "Close it first."
msgstr "Feche-o antes."

#: launcher/core/checks.cpp
#, qt-format
msgid "Connect from the WiVRn app in the headset."
msgstr "Conecte pelo app do WiVRn no headset."

#: launcher/core/checks.cpp
#, qt-format
msgid "Every patch still fits, but this release was tested with X4 %1."
msgstr ""
"Todos os patches ainda se encaixam, mas esta versão foi testada com o X4 %1."

#: launcher/core/checks.cpp
#, qt-format
msgid "GPU capable"
msgstr "GPU compatível"

#: launcher/core/checks.cpp
#, qt-format
msgid "Headset not connected"
msgstr "Headset não conectado"

#: launcher/core/checks.cpp
#, qt-format
msgid "Install it from your package manager."
msgstr "Instale-o pelo gerenciador de pacotes."

#: launcher/core/checks.cpp
#, qt-format
msgid "Install the OpenXR loader from your package manager."
msgstr ""
"Instale o carregador do OpenXR (OpenXR loader) pelo gerenciador de pacotes."

#: launcher/core/checks.cpp
#, qt-format
msgid ""
"It isn't in Steam's libraries or the usual GOG folders. Choose its folder."
msgstr ""
"Não está nas bibliotecas da Steam nem nas pastas usuais do GOG. Escolha a "
"pasta dele."

#: launcher/core/checks.cpp
#, qt-format
msgid "It needs Vulkan 1.2 with multiview and at least 7 descriptor sets."
msgstr "É preciso Vulkan 1.2 com multiview e pelo menos 7 descriptor sets."

#: launcher/core/checks.cpp
#, qt-format
msgid "Layer %1, injector %2, this launcher %3."
msgstr "Camada: %1, injetor: %2, este launcher: %3."

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod installed"
msgstr "Mod instalado"

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod not installed"
msgstr "Mod não instalado"

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod out of date"
msgstr "Mod desatualizado"

#: launcher/core/checks.cpp
#, qt-format
msgid "No GPU can run the mod"
msgstr "Nenhuma GPU consegue rodar o mod"

#: launcher/core/checks.cpp
#, qt-format
msgid "No VR runtime running"
msgstr "Nenhum runtime de VR em execução"

#: launcher/core/checks.cpp
#, qt-format
msgid "No Vulkan layer manifest at %1"
msgstr "Nenhum manifesto da camada Vulkan em %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "Not tested with X4 %1"
msgstr "Não testado com o X4 %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "OpenXR isn't installed"
msgstr "O OpenXR não está instalado"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam isn't running"
msgstr "A Steam não está em execução"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam running"
msgstr "Steam em execução"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam's Flatpak isn't supported"
msgstr "A Steam em Flatpak não é suportada"

#: launcher/core/checks.cpp
#, qt-format
msgid "SteamVR is running and waiting for the headset. Connect it, then Retry."
msgstr ""
"O SteamVR está em execução, aguardando o headset. Conecte-o e clique em "
"Tentar de novo."

#: launcher/core/checks.cpp
#, qt-format
msgid "The Steam version of X4 needs Steam open."
msgstr "A versão Steam do X4 precisa da Steam aberta."

#: launcher/core/checks.cpp
#, qt-format
msgid "The VR runtime"
msgstr "O runtime de VR"

#: launcher/core/checks.cpp
#, qt-format
msgid "The Vulkan layer's manifest names a library that isn't there: %1"
msgstr ""
"O manifesto da camada Vulkan aponta para uma biblioteca que não existe: %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "The injector isn't there: %1"
msgstr "O injetor não foi encontrado: %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "The mod fits this X4"
msgstr "O mod é compatível com este X4"

#: launcher/core/checks.cpp
#, qt-format
msgid "The x4vrmod extension isn't in X4's folder."
msgstr "A extensão x4vrmod não está na pasta do X4."

#: launcher/core/checks.cpp
#, qt-format
msgid "These turn off: %1."
msgstr "Estes recursos ficam desligados: %1."

#: launcher/core/checks.cpp
#, qt-format
msgid ""
"This X4 is Steam's Flatpak copy, and the mod can't reach into that sandbox. "
"Use Steam from your distribution's packages, or a GOG copy."
msgstr ""
"Este X4 é a cópia da Steam em Flatpak, e o mod não alcança aquela sandbox. "
"Use a Steam dos pacotes da sua distribuição, ou uma cópia do GOG."

#: launcher/core/checks.cpp
#, qt-format
msgid "This is the Windows version of X4"
msgstr "Esta é a versão para Windows do X4"

#: launcher/core/checks.cpp
#, qt-format
msgid "VR ready"
msgstr "VR pronto"

#: launcher/core/checks.cpp
#, qt-format
msgid "VR runtime not answering"
msgstr "O runtime de VR não responde"

#: launcher/core/checks.cpp
#, qt-format
msgid "Vulkan not working"
msgstr "O Vulkan não está funcionando"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 build not supported yet"
msgstr "Esta versão do X4 ainda não é suportada"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 found"
msgstr "X4 encontrado"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 is already running"
msgstr "O X4 já está em execução"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not found"
msgstr "X4 não encontrado"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not found there"
msgstr "X4 não encontrado ali"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not running yet"
msgstr "O X4 ainda não está em execução"

#: launcher/core/checks.cpp
#, qt-format
msgid "all %1 feature matches its code"
msgid_plural "all %1 features match its code"
msgstr[0] "%1 recurso confere com o código do jogo"
msgstr[1] "todos os %1 recursos conferem com o código do jogo"

#: launcher/core/checks.cpp
#, qt-format
msgid "gamescope installed"
msgstr "gamescope instalado"

#: launcher/core/checks.cpp
#, qt-format
msgid "gamescope isn't installed"
msgstr "O gamescope não está instalado"

#: launcher/core/checks.cpp
#, qt-format
msgid "unknown"
msgstr "versão desconhecida"

#: launcher/core/discover.cpp
#, qt-format
msgid "Other"
msgstr "Outro"

#: launcher/core/discover.cpp
#, qt-format
msgid ""
"This is the Windows version of X4, which runs through Proton. The mod works "
"only with the Linux version: it's a Vulkan layer and a preloaded library "
"that attach to the Linux program. On Steam, open X4's Properties, then "
"Compatibility, and turn off forced compatibility so Steam downloads the "
"Linux version."
msgstr ""
"Esta é a versão para Windows do X4, que roda pelo Proton. O mod só funciona "
"com a versão para Linux: ele é uma camada Vulkan e uma biblioteca pré-"
"carregada que se acoplam ao programa Linux. Na Steam, abra as Propriedades "
"do X4, depois Compatibilidade, e desative a compatibilidade forçada para que "
"a Steam baixe a versão para Linux."

#: launcher/core/discover.cpp
#, qt-format
msgid "no X4 program in that folder"
msgstr "não há programa do X4 nessa pasta"

#: launcher/core/discover.cpp
#, qt-format
msgid "that isn't the X4 program"
msgstr "não é o programa do X4"

#: launcher/core/discover.cpp
#, qt-format
msgid "that path doesn't exist"
msgstr "esse caminho não existe"

#: launcher/core/discover.cpp
#, qt-format
msgid "that's a Linux program, but not one called X4"
msgstr "é um programa Linux, mas não se chama X4"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't copy %1: %2"
msgstr "Não foi possível copiar %1: %2"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't copy the mod to %1: %2"
msgstr "Não foi possível copiar o mod para %1: %2"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't put the extension in X4's folder: %1"
msgstr "Não foi possível colocar a extensão na pasta do X4: %1"

#: launcher/core/install.cpp launcher/gui/window.cpp
#, qt-format
msgid "Couldn't write %1"
msgstr "Não foi possível gravar %1"

#: launcher/core/install.cpp
#, qt-format
msgid "Install the mod first: the menu needs the copy whose path stays."
msgstr "Instale o mod primeiro: o menu precisa da cópia cujo caminho não muda."

#: launcher/core/install.cpp
#, qt-format
msgid "The package itself stays. Remove it with your package manager."
msgstr ""
"O pacote em si continua instalado. Remova-o pelo gerenciador de pacotes."

#: launcher/core/install.cpp
#, qt-format
msgid "This copy of the mod is incomplete: no %1"
msgstr "Esta cópia do mod está incompleta: falta %1"

#: launcher/core/install.cpp
#, qt-format
msgid "This copy of the mod is incomplete: no layer manifest template."
msgstr ""
"Esta cópia do mod está incompleta: falta o modelo do manifesto da camada."

#: launcher/core/install.cpp
#, qt-format
msgid ""
"X4 marks saves made with a non-Egosoft extension as modified; the mod's "
"extension is enabled only in VR sessions."
msgstr ""
"O X4 marca como modificados os saves feitos com uma extensão que não é da "
"Egosoft; a extensão do mod só fica ativa nas sessões em VR."

#: launcher/core/install.cpp
#, qt-format
msgid "X4 wasn't found."
msgstr "O X4 não foi encontrado."

