msgstr "A tela de carregamento do mod"

#: launcher/core/patches.cpp
#, qt-format
msgid "The shadow fix"
msgstr "A correção das sombras"

#: launcher/core/patches.cpp
#, qt-format
msgid "The steering target drawn in VR"
msgstr "O alvo de pilotagem desenhado em VR"

#: launcher/core/profile.cpp
#, qt-format
msgid "Above 4068 the map's 3D view is flat, not in depth."
msgstr "Acima de 4068, a visão 3D do mapa fica plana, sem profundidade."

#: launcher/core/profile.cpp
#, qt-format
