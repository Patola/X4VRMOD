msgstr "%1 está em execução, sem headset conectado."

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, %2. It recommends %3 x %4 per eye."
msgstr "%1, %2. Recomenda %3 x %4 por olho."

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, DLSS available"
msgstr "%1, DLSS disponível"

#: launcher/core/checks.cpp
#, qt-format
