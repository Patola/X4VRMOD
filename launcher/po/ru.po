msgstr "Расширения x4vrmod нет в папке X4."

#: launcher/core/checks.cpp
#, qt-format
msgid "These turn off: %1."
msgstr "Будут отключены: %1."

#: launcher/core/checks.cpp
#, qt-format
msgid ""
"This X4 is Steam's Flatpak copy, and the mod can't reach into that sandbox. "
"Use Steam from your distribution's packages, or a GOG copy."
msgstr ""
"Это копия X4 из Steam в Flatpak, а мод не может проникнуть в эту песочницу. "
"Используйте Steam из пакетов вашего дистрибутива или копию из GOG."

#: launcher/core/checks.cpp
#, qt-format
