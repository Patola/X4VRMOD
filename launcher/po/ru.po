msgstr "Не в формате NAME=value: %1"

#: launcher/gui/dialogs.cpp
#, qt-format
msgid "Nothing of the mod's is installed."
msgstr "Ничего из мода не установлено."

#: launcher/gui/dialogs.cpp
#, qt-format
msgid "Open a GitHub issue"
msgstr "Открыть issue на GitHub"

