msgstr "DLSS Ausgewogen"

#: launcher/core/profile.cpp
#, qt-format
msgid "DLSS DLAA (anti-aliasing only)"
msgstr "DLSS DLAA (nur Kantenglättung)"

#: launcher/core/profile.cpp
#, qt-format
msgid "DLSS Performance"
msgstr "DLSS Leistung"

#: launcher/core/profile.cpp
#, qt-format
