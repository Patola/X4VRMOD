#: launcher/core/checks.cpp
#, qt-format
msgid "%1 is running, with no headset connected."
msgstr "%1 läuft, aber kein Headset ist verbunden."

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, %2. It recommends %3 x %4 per eye."
msgstr "%1, %2. Empfohlen: %3 x %4 pro Auge."

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, DLSS available"
msgstr "%1, DLSS verfügbar"

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, Vulkan %2"
msgstr "%1, Vulkan %2"

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, X4 %2"
msgstr "%1, X4 %2"

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, X4 %2, build %3"
msgstr "%1, X4 %2, Build %3"

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, headset connected. It recommends %2 x %3 per eye."
msgstr "%1, Headset verbunden. Empfohlen: %2 x %3 pro Auge."

