msgstr "DLSS Qualität"

#: launcher/core/profile.cpp
#, qt-format
msgid "DLSS Ultra Performance"
msgstr "DLSS Ultra-Leistung"

#: launcher/core/profile.cpp
#, qt-format
msgid ""
"DLSS hasn't been played in a headset yet. If an eye looks wrong, please "
"report it."
msgstr ""
"DLSS wurde noch nie in einem Headset gespielt. Wenn ein Auge falsch "
"aussieht, melde es bitte."

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 1 Balanced"
msgstr "FSR 1 Ausgewogen"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 1 Performance"
msgstr "FSR 1 Leistung"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 1 Quality"
msgstr "FSR 1 Qualität"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 1 Quality chosen for this size. Choose None for full resolution."
msgstr ""
"FSR 1 Qualität für diese Größe gewählt. Wähle Keiner für volle Auflösung."

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 1 Ultra Quality"
msgstr "FSR 1 Ultra-Qualität"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 3 Balanced"
msgstr "FSR 3 Ausgewogen"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 3 Native (anti-aliasing only)"
msgstr "FSR 3 Nativ (nur Kantenglättung)"

#: launcher/core/profile.cpp
#, qt-format
msgid "FSR 3 Performance"
msgstr "FSR 3 Leistung"

#: launcher/core/profile.cpp
#, qt-format
