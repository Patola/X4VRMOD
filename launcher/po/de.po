#: launcher/core/checks.cpp
#, qt-format
msgid "%1 didn't answer in time."
msgstr "%1 hat nicht rechtzeitig geantwortet."

#: launcher/core/checks.cpp
#, qt-format
msgid "%1 didn't start: %2"
