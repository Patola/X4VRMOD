msgstr "%1, aktuell"

#: launcher/core/checks.cpp
#, qt-format
msgid "%1, updates when you play"
msgstr "%1, wird beim Spielen aktualisiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "Can't read X4's program"
msgstr "Das X4-Programm lässt sich nicht lesen"

#: launcher/core/checks.cpp
#, qt-format
msgid "Close it first."
msgstr "Schließe es zuerst."

#: launcher/core/checks.cpp
#, qt-format
msgid "Connect from the WiVRn app in the headset."
msgstr "Verbinde dich über die WiVRn-App im Headset."

#: launcher/core/checks.cpp
#, qt-format
msgid "Every patch still fits, but this release was tested with X4 %1."
msgstr "Alle Patches passen noch, aber diese Version wurde mit X4 %1 getestet."

#: launcher/core/checks.cpp
#, qt-format
msgid "GPU capable"
msgstr "GPU geeignet"

#: launcher/core/checks.cpp
#, qt-format
msgid "Headset not connected"
msgstr "Headset nicht verbunden"

#: launcher/core/checks.cpp
#, qt-format
msgid "Install it from your package manager."
msgstr "Installiere es über deine Paketverwaltung."

#: launcher/core/checks.cpp
#, qt-format
msgid "Install the OpenXR loader from your package manager."
msgstr "Installiere den OpenXR-Loader über deine Paketverwaltung."

#: launcher/core/checks.cpp
#, qt-format
msgid ""
"It isn't in Steam's libraries or the usual GOG folders. Choose its folder."
msgstr ""
"Es ist weder in den Steam-Bibliotheken noch in den üblichen GOG-Ordnern. "
"Wähle seinen Ordner."

#: launcher/core/checks.cpp
#, qt-format
msgid "It needs Vulkan 1.2 with multiview and at least 7 descriptor sets."
msgstr ""
"Benötigt wird Vulkan 1.2 mit Multiview und mindestens 7 Descriptor-Sets."

#: launcher/core/checks.cpp
#, qt-format
msgid "Layer %1, injector %2, this launcher %3."
msgstr "Layer %1, Injektor %2, dieser Launcher %3."

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod installed"
msgstr "Mod installiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod not installed"
msgstr "Mod nicht installiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "Mod out of date"
msgstr "Mod veraltet"

#: launcher/core/checks.cpp
#, qt-format
msgid "No GPU can run the mod"
msgstr "Keine GPU kann die Mod ausführen"

#: launcher/core/checks.cpp
#, qt-format
msgid "No VR runtime running"
msgstr "Keine VR-Runtime läuft"

#: launcher/core/checks.cpp
#, qt-format
msgid "No Vulkan layer manifest at %1"
msgstr "Kein Vulkan-Layer-Manifest unter %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "Not tested with X4 %1"
msgstr "Nicht mit X4 %1 getestet"

#: launcher/core/checks.cpp
#, qt-format
msgid "OpenXR isn't installed"
msgstr "OpenXR ist nicht installiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam isn't running"
msgstr "Steam läuft nicht"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam running"
msgstr "Steam läuft"

#: launcher/core/checks.cpp
#, qt-format
msgid "Steam's Flatpak isn't supported"
msgstr "Steam als Flatpak wird nicht unterstützt"

#: launcher/core/checks.cpp
#, qt-format
msgid "SteamVR is running and waiting for the headset. Connect it, then Retry."
msgstr ""
"SteamVR läuft und wartet auf das Headset. Verbinde es und klicke dann auf "
"Erneut versuchen."

#: launcher/core/checks.cpp
#, qt-format
msgid "The Steam version of X4 needs Steam open."
msgstr "Die Steam-Version von X4 braucht ein laufendes Steam."

#: launcher/core/checks.cpp
#, qt-format
msgid "The VR runtime"
msgstr "Die VR-Runtime"

#: launcher/core/checks.cpp
#, qt-format
msgid "The Vulkan layer's manifest names a library that isn't there: %1"
msgstr "Das Manifest des Vulkan-Layers nennt eine Bibliothek, die fehlt: %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "The injector isn't there: %1"
msgstr "Der Injektor fehlt: %1"

#: launcher/core/checks.cpp
#, qt-format
msgid "The mod fits this X4"
msgstr "Die Mod passt zu diesem X4"

#: launcher/core/checks.cpp
#, qt-format
msgid "The x4vrmod extension isn't in X4's folder."
msgstr "Die Erweiterung x4vrmod ist nicht im X4-Ordner."

#: launcher/core/checks.cpp
#, qt-format
msgid "These turn off: %1."
msgstr "Diese Funktionen werden abgeschaltet: %1."

#: launcher/core/checks.cpp
#, qt-format
msgid ""
"This X4 is Steam's Flatpak copy, and the mod can't reach into that sandbox. "
"Use Steam from your distribution's packages, or a GOG copy."
msgstr ""
"Dieses X4 ist die Kopie des Flatpak-Steams, und die Mod erreicht diese "
"Sandbox nicht. Nutze Steam aus den Paketen deiner Distribution oder eine GOG-"
"Kopie."

#: launcher/core/checks.cpp
#, qt-format
msgid "This is the Windows version of X4"
msgstr "Das ist die Windows-Version von X4"

#: launcher/core/checks.cpp
#, qt-format
msgid "VR ready"
msgstr "VR bereit"

#: launcher/core/checks.cpp
#, qt-format
msgid "VR runtime not answering"
msgstr "VR-Runtime antwortet nicht"

#: launcher/core/checks.cpp
#, qt-format
msgid "Vulkan not working"
msgstr "Vulkan funktioniert nicht"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 build not supported yet"
msgstr "Diese X4-Version wird noch nicht unterstützt"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 found"
msgstr "X4 gefunden"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 is already running"
msgstr "X4 läuft bereits"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not found"
msgstr "X4 nicht gefunden"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not found there"
msgstr "X4 dort nicht gefunden"

#: launcher/core/checks.cpp
#, qt-format
msgid "X4 not running yet"
msgstr "X4 läuft noch nicht"

#: launcher/core/checks.cpp
#, qt-format
msgid "all %1 feature matches its code"
msgid_plural "all %1 features match its code"
msgstr[0] "%1 Funktion passt zum Code des Spiels"
msgstr[1] "alle %1 Funktionen passen zum Code des Spiels"

#: launcher/core/checks.cpp
#, qt-format
msgid "gamescope installed"
msgstr "gamescope installiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "gamescope isn't installed"
msgstr "gamescope ist nicht installiert"

#: launcher/core/checks.cpp
#, qt-format
msgid "unknown"
msgstr "unbekannt"

#: launcher/core/discover.cpp
#, qt-format
msgid "Other"
msgstr "Andere"

#: launcher/core/discover.cpp
#, qt-format
msgid ""
"This is the Windows version of X4, which runs through Proton. The mod works "
"only with the Linux version: it's a Vulkan layer and a preloaded library "
"that attach to the Linux program. On Steam, open X4's Properties, then "
"Compatibility, and turn off forced compatibility so Steam downloads the "
"Linux version."
msgstr ""
"Das ist die Windows-Version von X4, die über Proton läuft. Die Mod "
"funktioniert nur mit der Linux-Version: Sie besteht aus einem Vulkan-Layer "
"und einer vorab geladenen Bibliothek, die sich an das Linux-Programm hängen. "
"Öffne in Steam die Eigenschaften von X4, dann Kompatibilität, und schalte "
"die erzwungene Kompatibilität aus, damit Steam die Linux-Version "
"herunterlädt."

#: launcher/core/discover.cpp
#, qt-format
msgid "no X4 program in that folder"
msgstr "kein X4-Programm in diesem Ordner"

#: launcher/core/discover.cpp
#, qt-format
msgid "that isn't the X4 program"
msgstr "das ist nicht das X4-Programm"

#: launcher/core/discover.cpp
#, qt-format
msgid "that path doesn't exist"
msgstr "diesen Pfad gibt es nicht"

#: launcher/core/discover.cpp
#, qt-format
msgid "that's a Linux program, but not one called X4"
msgstr "das ist ein Linux-Programm, aber keines namens X4"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't copy %1: %2"
msgstr "%1 konnte nicht kopiert werden: %2"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't copy the mod to %1: %2"
msgstr "Die Mod konnte nicht nach %1 kopiert werden: %2"

#: launcher/core/install.cpp
#, qt-format
msgid "Couldn't put the extension in X4's folder: %1"
msgstr "Die Erweiterung konnte nicht in den X4-Ordner gelegt werden: %1"

#: launcher/core/install.cpp launcher/gui/window.cpp
#, qt-format
msgid "Couldn't write %1"
msgstr "%1 konnte nicht geschrieben werden"

#: launcher/core/install.cpp
#, qt-format
msgid "Install the mod first: the menu needs the copy whose path stays."
msgstr ""
"Installiere zuerst die Mod: Das Menü braucht die Kopie, deren Pfad bleibt."

#: launcher/core/install.cpp
#, qt-format
msgid "The package itself stays. Remove it with your package manager."
msgstr "Das Paket selbst bleibt. Entferne es über deine Paketverwaltung."

#: launcher/core/install.cpp
#, qt-format
msgid "This copy of the mod is incomplete: no %1"
msgstr "Diese Kopie der Mod ist unvollständig: %1 fehlt"

#: launcher/core/install.cpp
#, qt-format
msgid "This copy of the mod is incomplete: no layer manifest template."
msgstr ""
"Diese Kopie der Mod ist unvollständig: Die Vorlage für das Layer-Manifest "
"fehlt."

#: launcher/core/install.cpp
#, qt-format
msgid ""
"X4 marks saves made with a non-Egosoft extension as modified; the mod's "
"extension is enabled only in VR sessions."
msgstr ""
"X4 markiert Spielstände, die mit einer Erweiterung von außerhalb Egosofts "
"entstanden sind, als modifiziert; die Erweiterung der Mod ist nur in VR-"
"Sitzungen aktiv."

#: launcher/core/install.cpp
#, qt-format
msgid "X4 wasn't found."
msgstr "X4 wurde nicht gefunden."

#: launcher/core/patches.cpp
#, qt-format
msgid "Aiming at where the steering target points"
msgstr "Zielen dorthin, wohin das Steuerziel zeigt"

#: launcher/core/patches.cpp
#, qt-format
msgid "Clicking the cockpit HUD"
msgstr "Klicks auf das Cockpit-HUD"

#: launcher/core/patches.cpp
#, qt-format
msgid "DLSS in both eyes"
msgstr "DLSS auf beiden Augen"

#: launcher/core/patches.cpp
#, qt-format
msgid "Head tracking in the cockpit"
msgstr "Headtracking im Cockpit"

#: launcher/core/patches.cpp
#, qt-format
msgid "Head tracking in the external views (F2, F3, F4)"
msgstr "Headtracking in den Außenansichten (F2, F3, F4)"

#: launcher/core/patches.cpp
#, qt-format
msgid "Looking around while walking"
msgstr "Umschauen beim Gehen"

#: launcher/core/patches.cpp
#, qt-format
msgid "Menus lined up with the cursor"
msgstr "Menüs am Mauszeiger ausgerichtet"

#: launcher/core/patches.cpp
#, qt-format
msgid "The mod's loading screen"
msgstr "Der Ladebildschirm der Mod"

#: launcher/core/patches.cpp
#, qt-format
msgid "The shadow fix"
msgstr "Die Schattenkorrektur"

#: launcher/core/patches.cpp
#, qt-format
msgid "The steering target drawn in VR"
msgstr "Das Steuerziel in VR"

#: launcher/core/profile.cpp
#, qt-format
msgid "Above 4068 the map's 3D view is flat, not in depth."
msgstr "Über 4068 ist die 3D-Ansicht der Karte flach, ohne Tiefe."

#: launcher/core/profile.cpp
#, qt-format
msgid "At 4224 SteamVR has shown a jumbled picture. If you see that, go lower."
msgstr ""
"Bei 4224 hat SteamVR schon ein verworrenes Bild gezeigt. Wenn du das siehst, "
"geh niedriger."

#: launcher/core/profile.cpp
#, qt-format
msgid "DLSS Auto"
msgstr "DLSS Auto"

#: launcher/core/profile.cpp
#, qt-format
