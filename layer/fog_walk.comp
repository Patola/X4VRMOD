#version 450
// SPDX-License-Identifier: GPL-3.0-or-later WITH x4vrmod-linking-exception
//
// The nebula's smoke, our own: this takes the place of X4's volume_walk.comp, the stage
// of its froxel fog that turns density into light. X4 lit the fog by its sun alone, and
// that light changed as the head turned (takes 478-479). X4's nebula cards glowed
// instead (additive), so this glows, in the sector's light colour deepened, and absorbs
// what is behind it.
//
// After take 480 ("the puffs seemed to change their contours according to my head
// turning"; the space "white with some few fuzzy holes"):
//
//  * **One sample per slice changed with the head.** X4's slices are planes square to the
//    view, about 80 m apart at 1 km. Turning the head moves where those planes cut a
//    line of sight fixed in the world, so a slice's one sample landed elsewhere in the
//    smoke. An offline model of this grid gave a 10-30 deg turn a change of 4% of the
//    smoke's glow on average and 20% in places (7% and 40% with these ribbons); stepping
//    along each column's ray no farther than kStepFrac of the distance (at least
//    kMinStep, at most kMaxSub steps a slice) brought both to 0.3% and 1.6%. And no
//    wisp is drawn thinner than kRes of X4's columns at its distance, where the blend's
//    interpolation would make it shimmer.
//  * **Its shape** (after take 481: ours "bigger and fuzzier", blobs; X4's "more defined,
//    stringier and look smaller"). X4's cards are flat pictures about 670 m across, drawn
//    500-3000 m away at the screen's resolution; reduced to X4's grid at those distances
//    even their strings turn into a soft cloud. What the grid can carry is the card's
//    outline: so, clouds about kCloud across, lobed, sparse (kCover), with an edge never
//    sharper than kRes columns; mottled inside (kMottle and half of it); and near the
//    ship, where the columns are a few metres wide, strings (kString) -- where two curled
//    sheets cross. Each layer is drawn only where the columns can carry it and is its
//    average elsewhere. It drifts (kDrift) and its curl changes slowly.
//  * **Cheaper.** A point outside every cloud costs one or two noise lookups: the cloud
//    test comes first, and its second octave is skipped where it cannot make a cloud.
//    Its colour is the sector's light colour deepened (each channel to the power kTint):
//    teal in Turquoise Sea IX.
//
// X4's interface, exactly (x4vr::spv::is_x4_volume_walk checks X4's module first): the
// camera block at set 1 binding 0, at the offsets below; the output's index at
// OUT_IDX_OFFSET of the block at set 4 binding 0 (464 where X4 walks one medium, 480
// where it walks two); the Rgba16f 3D storage-image table at set 0 binding 6; 8x8x1.
// Each cell stores, as X4's does, the light gathered from the camera up to it (rgb) and
// what of the scene behind still shows (a); X4's blend then does colour * a + rgb.
//
// And the layer's own block, x4vr::PoseBlock, at the set the layer binds it to: written
// here as 31 and renumbered by the layer when it creates the module. Its `fog` member
// scales the smoke's density (x, 0 for none), its glow (y) and its size (z): an A/B's
// phases switch them without a new pipeline.
#extension GL_ARB_enhanced_layouts : require

#ifndef OUT_IDX_OFFSET
#define OUT_IDX_OFFSET 464
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, std140) uniform X4Camera {
    layout(offset = 128) mat4 M_invprojection;
    layout(offset = 512) mat4 M_viewinverse;
    layout(offset = 736) vec4 V_cameraposition;
    layout(offset = 784) vec4 V_lightcolor1;
    layout(offset = 960) vec4 V_volume_size;
    layout(offset = 1420) float F_time;
    layout(offset = 1528) float F_volume_off;
    layout(offset = 1532) float F_volume_scale;
};
layout(set = 4, binding = 0, std140) uniform X4Dynamic {
    layout(offset = OUT_IDX_OFFSET) uint S_output_rt_idx;
};
layout(set = 0, binding = 6, rgba16f) uniform restrict writeonly image3D U_output_rt_decl[53306];
layout(set = 31, binding = 0, std140) uniform X4vrPose {
    layout(offset = 288) vec4 fog; // x4vr::kPoseFogOffset
} pose;

// Chosen in an offline model of X4's grid (takes 480-481), against X4's own cards reduced
// to the grid: separate clouds with dark space between, about a third of the view
// touched, and as steady under a head turn as take 481's smoke.
layout(constant_id = 0) const float kCloud = 670.0;     // a cloud, m (X4's cards: ~670)
layout(constant_id = 1) const float kCover = 0.68;      // where a cloud starts: sparse
layout(constant_id = 2) const float kSoft = 0.05;       // its edge, at the sharpest
layout(constant_id = 3) const float kRes = 2.5;         // nothing sharper than this many columns
layout(constant_id = 4) const float kWarpScale = 400.0; // the curl, m
layout(constant_id = 5) const float kMottle = 200.0;    // the mottling inside, m (and half)
layout(constant_id = 6) const float kMottleGain = 3.0;  // its contrast
layout(constant_id = 7) const float kCurl = 0.8;        // how much the curl moves it
layout(constant_id = 8) const float kString = 60.0;     // the strings near the ship, m
layout(constant_id = 9) const float kGain = 4.0;        // how thin they are
layout(constant_id = 10) const float kStretch = 1.5;    // drawn out along x
layout(constant_id = 11) const float kStringWeight = 0.5; // strings against mottling
layout(constant_id = 12) const float kStringBoost = 4.0;  // a string's density over the mottling's
layout(constant_id = 13) const float kNearKeep = 0.3;   // what is left at the ship
layout(constant_id = 14) const float kNear0 = 40.0;     // thinned from here...
layout(constant_id = 15) const float kNear1 = 400.0;    // ...to here, m
layout(constant_id = 16) const float kSigma = 0.003;    // extinction at full density, 1/m
layout(constant_id = 17) const float kBright = 0.3;     // the glow of an opaque cloud
layout(constant_id = 18) const float kFar = 2500.0;     // everything fades by here, m
layout(constant_id = 19) const float kMinStep = 6.0;    // the march: steps at least this, m
layout(constant_id = 20) const float kStepFrac = 0.03;  // at most this of the distance
layout(constant_id = 21) const float kMaxSub = 8.0;     // and at most this many a slice
layout(constant_id = 22) const float kDrift = 4.0;      // m/s
layout(constant_id = 23) const float kTint = 3.0;       // the light colour, deepened

float hash31(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
}
float vnoise(vec3 x) {
    const vec3 i = floor(x), f = fract(x);
    const vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(hash31(i + vec3(0, 0, 0)), hash31(i + vec3(1, 0, 0)), u.x),
                   mix(hash31(i + vec3(0, 1, 0)), hash31(i + vec3(1, 1, 0)), u.x), u.y),
               mix(mix(hash31(i + vec3(0, 0, 1)), hash31(i + vec3(1, 0, 1)), u.x),
                   mix(hash31(i + vec3(0, 1, 1)), hash31(i + vec3(1, 1, 1)), u.x), u.y),
               u.z);
}
// A sheet where the noise crosses its middle: 1 on it, 0 a little away.
float sheet(float n) {
    return clamp(1.0 - abs(n - 0.5) * kGain, 0.0, 1.0);
}

// The smoke's density, 0..1, at a world point at time t, `dist` metres from the camera,
// where one of X4's columns is `cell` metres wide; `size` scales every length.
float smoke(vec3 world, float t, float dist, float cell, float size) {
    // The clouds drift; kept small, since the world is millions of metres across and a
    // float has 24 bits.
    vec3 p = world + vec3(0.0, 0.0, t * kDrift);
    p -= floor(p / 65536.0) * 65536.0;
    const float cl = kCloud * size;
    const float soft = max(kSoft, 0.45 * kRes * cell / cl);
    const float lo = kCover - soft;
    const float c1 = vnoise(p / cl + vec3(3.3, 7.1, 1.9));
    if (0.65 * c1 + 0.35 <= lo)
        return 0.0; // the second octave cannot make a cloud here
    const float cloud = smoothstep(lo, kCover + soft,
                                   0.65 * c1 + 0.35 * vnoise(p / (0.4 * cl) + vec3(9.1, 2.2, 5.5)));
    if (cloud <= 0.001)
        return 0.0;
    const float ws = kWarpScale * size;
    const vec3 w = vec3(vnoise(p / ws + vec3(5.2, 1.3, 7.7) + t * 0.010),
                        vnoise(p / ws + vec3(1.7, 9.2, 3.4) - t * 0.012),
                        vnoise(p / ws + vec3(8.3, 2.8, 4.6) + t * 0.008)) - 0.5;
    // Mottling: two octaves, each its average where its wavelength is under 4 kRes columns.
    float mot = 0.0;
    for (int k = 0; k < 2; ++k) {
        const float lam = kMottle * size / float(1 << k);
        const float f = smoothstep(1.0, 2.0, lam / (4.0 * kRes * cell));
        const float n = f > 0.0 ? vnoise(p / lam + w * (kCurl * ws / lam) + float(k) * vec3(13.7, 5.1, 8.9))
                                : 0.5;
        mot += (k == 0 ? 0.65 : 0.35) * mix(0.5, n, f);
    }
    mot = clamp((mot - 0.5) * kMottleGain + 0.5, 0.0, 1.0);
    // Strings, where two curled sheets cross -- only where they are kRes columns thick.
    float str = 0.0;
    const float lam = kString * size;
    const float f = smoothstep(1.0, 2.0, lam / (kGain * kRes * cell));
    if (f > 0.0) {
        vec3 r = p / lam + w * (kCurl * ws / lam);
        r.x /= kStretch;
        str = f * sheet(vnoise(r + vec3(1.1, 2.2, 3.3))) * sheet(vnoise(r + vec3(31.7, 11.3, 23.9)));
    }
    const float inner = mot * (1.0 - kStringWeight) + kStringWeight * str * kStringBoost;
    const float near = kNearKeep + (1.0 - kNearKeep) * smoothstep(kNear0, kNear1, dist);
    return cloud * inner * near;
}

vec3 cell_view(vec3 uv) {
    const vec3 cs = vec3(uv.xy * 2.0 - 1.0, uv.z * uv.z * F_volume_scale + F_volume_off);
    const vec4 p = M_invprojection * vec4(cs, 1.0);
    return p.xyz / p.w;
}

void main() {
    const uvec2 id = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(id, uvec2(V_volume_size.xy))))
        return;
    const vec3 size = V_volume_size.xyz;
    // Each cell at its texel's centre, where X4's blend (textureLod, linear) finds it.
    const vec2 uv = (vec2(id) + 0.5) / size.xy;
    const vec3 t4 = M_viewinverse[3].xyz;
    const vec3 anchor = dot(t4, t4) < 1.0 ? V_cameraposition.xyz : vec3(0.0);
    const vec3 origin = t4 + anchor;
    const vec3 ray_view = normalize(cell_view(vec3(uv, 0.5)));
    const vec3 ray = normalize(mat3(M_viewinverse) * ray_view);
    // One column's width at a metre, across the middle of the view.
    const vec3 a = cell_view(vec3(0.0, 0.5, 0.5)), b = cell_view(vec3(1.0, 0.5, 0.5));
    const float col = abs(b.x - a.x) / max(abs(a.z), 1e-6) / size.x;
    const vec4 knobs = pose.fog;
    const float shape = knobs.z > 0.0 ? knobs.z : 1.0; // the smoke's size
    const vec3 lc = max(V_lightcolor1.rgb, vec3(1e-4));
    const vec3 glow = kBright * knobs.y * pow(lc / max(max(lc.r, lc.g), lc.b), vec3(kTint));

    vec3 light = vec3(0.0);
    float trans = 1.0;
    // From X4's near end (its last slice is the nearest, 32 m; its first the farthest),
    // the integral along the ray up to each slice.
    float prev = length(cell_view(vec3(uv, 1.0)));
    for (int z = int(size.z) - 1; z >= 0; --z) {
        const float tz = length(cell_view(vec3(uv, (float(z) + 0.5) / size.z)));
        if (knobs.x > 0.0 && prev < kFar && tz > prev) {
            const float seg = tz - prev;
            const float s = max(kMinStep, kStepFrac * 0.5 * (prev + tz));
            const int n = int(clamp(ceil(seg / s), 1.0, kMaxSub));
            const float stp = seg / float(n);
            for (int i = 0; i < n; ++i) {
                const float t = prev + (float(i) + 0.5) * stp;
                const float d = knobs.x * smoke(origin + ray * t, F_time, t, col * t, shape) *
                                (1.0 - smoothstep(0.6 * kFar, kFar, t));
                if (d > 0.0) {
                    const float slice = exp(-kSigma * d * stp);
                    light += trans * glow * (1.0 - slice);
                    trans *= slice;
                }
            }
        }
        prev = max(prev, tz);
        imageStore(U_output_rt_decl[S_output_rt_idx], ivec3(ivec2(id), z), vec4(light, trans));
    }
}
