#version 450
// SPDX-License-Identifier: GPL-3.0-or-later WITH x4vrmod-linking-exception
//
// The nebula's smoke, marched per pixel (after take 486). X4's froxel grid -- 176 columns
// across a 110 deg field, about one a degree -- can carry only a blurry fog, and anything
// sharpened in it shows the grid as the head turns (takes 482-486). So this takes the
// place of X4's volume_walk and marches its own rays: one per pixel of a quarter-resolution
// view (kW x kH across X4's field), 4.3 a degree at the centre, through the smoke's own
// density, and writes what each ray gathered at kK depths into a volume of ours
// (x4vr march volume, set 31 binding 1). X4's fog blend, patched, reads it by the very
// lookup it used for its own grid (screen position, and depth by X4's mapping): so a ship
// inside the smoke is fogged only up to its own distance.
//
// What it computes is the offline model's (scratchpad march_model.py, takes 486-487):
// sparse clouds about kCloud across, mottled, and in them curly wisps at four sizes
// (kStr x 1, 2, 4, 8) -- each drawn only where it is at least kFootPx low-res pixels
// thick, its average elsewhere, so every distance keeps the finest wisps it can carry
// (as one of X4's cards does when drawn smaller) and none shimmers as the head turns. In
// the model a 10 deg head turn changed the picture by 0.0016 of glow at most in 99% of
// pixels (take 481's smoke: 0.0013); strafing 20 m, by about as little.
//
// The march's steps sit on planes square to the ray at multiples of their spacing in the
// world, so moving the ship cannot move where a ray is sampled. Its noise is a 64^3
// RGBA texture of ours (set 31 binding 3), four noises a fetch: on the GPU this was a
// quarter of the cost of computing it.
//
// X4's interface, exactly as volume_walk's (x4vr::spv::is_x4_volume_walk checks X4's
// module first): the camera block at set 1 binding 0. Unlike X4's walk this writes
// nothing of X4's: in our phases X4's blend reads our volume instead.
//
// The layer's block, x4vr::PoseBlock, at set 31 (renumbered by the layer): fog.x scales
// the density (0: none), fog.y the glow, fog.z the extinction (kSigma times it: denser,
// more defined), fog.w the wisps' thinness (kFootPx times it);
// fog2.x where the smoke ends, fog2.z its clock (s), fog2.w its haze (0: kHaze).
#extension GL_ARB_enhanced_layouts : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// The sets as X4 and the layer bind them; a stand-alone harness may move them.
#ifndef CAM_SET
#define CAM_SET 1
#define CAM_BINDING 0
#endif
#ifndef POSE_SET
#define POSE_SET 31
#endif

layout(set = CAM_SET, binding = CAM_BINDING, std140) uniform X4Camera {
    layout(offset = 128) mat4 M_invprojection;
    layout(offset = 512) mat4 M_viewinverse;
    layout(offset = 736) vec4 V_cameraposition;
    layout(offset = 784) vec4 V_lightcolor1;
    layout(offset = 1420) float F_time;
    layout(offset = 1528) float F_volume_off;
    layout(offset = 1532) float F_volume_scale;
};
layout(set = POSE_SET, binding = 0, std140) uniform X4vrPose {
    layout(offset = 288) vec4 fog;  // x4vr::kPoseFogOffset
    layout(offset = 304) vec4 fog2; // x: where the smoke ends, m (0: kFar); z: its clock, s; w: haze
} pose;
layout(set = POSE_SET, binding = 1, rgba16f) uniform restrict writeonly image3D march_out;
layout(set = POSE_SET, binding = 3) uniform sampler3D noise4;

// After take 491 ("still too strong and too big"): the clouds, their curl and mottling at
// 0.8 of their size, the wisps kept (smaller ones changed more as the head turned: 5.0% of
// the bright clouds at p99 against 4.5%, over 24 views), half as dense.
layout(constant_id = 0) const float kCloud = 536.0;    // a cloud, m (670 to 491)
layout(constant_id = 1) const float kCover = 0.70;     // where a cloud starts: sparse
layout(constant_id = 2) const float kSoft = 0.015;     // its edge (0.08 to take 488, 0.03 to 489)
layout(constant_id = 3) const float kWarp = 320.0;     // the clouds' curl, m (400)
layout(constant_id = 4) const float kMottle = 160.0;   // the mottling, m (and half) (200)
layout(constant_id = 5) const float kStr = 40.0;       // the finest wisps, m
layout(constant_id = 6) const float kGain = 7.0;       // how thin a wisp is
layout(constant_id = 7) const float kSharp = 3.0;      // and how sharp
layout(constant_id = 8) const float kMix = 0.95;       // wisps against the soft body (0.8)
layout(constant_id = 9) const float kStretch = 1.5;    // wisps drawn out along x
layout(constant_id = 10) const float kCurl = 3.0;      // how much the wisps curl
layout(constant_id = 11) const float kFootPx = 3.0;    // no wisp thinner than this many pixels
layout(constant_id = 12) const float kSigma = 0.0025;  // extinction at full density, 1/m (0.003 to 489, 0.005 to 491)
layout(constant_id = 13) const float kBright = 0.22;   // the glow of an opaque cloud (0.3 to 489)
layout(constant_id = 14) const float kFar = 2500.0;    // everything fades by here, m
layout(constant_id = 15) const float kDrift = 3.2;     // the clouds drift, m/s (4 to 491: with their size)
layout(constant_id = 16) const float kMorph = 61.6;    // their outlines slide, m/s (12 to 488, 48 to 489, 77 to 491)
layout(constant_id = 17) const float kChurn = 0.13;    // their curl churns, a second (0.02, 0.08)
layout(constant_id = 18) const float kTint = 3.0;      // the light colour, deepened
layout(constant_id = 19) const int kW = 704;           // the march's pixels across
layout(constant_id = 20) const int kH = 704;           // and down
layout(constant_id = 21) const int kK = 16;            // its depths
layout(constant_id = 22) const float kStepFrac = 0.03; // steps at most this of the distance
layout(constant_id = 23) const int kSkip = 1;          // skip space proven cloud-free
// What a wisp too thin to draw at its distance leaves behind (0.12 to take 488): X4's cards
// blur their unresolved strands into a dim average, and a bright one was the fuzz.
layout(constant_id = 24) const float kHaze = 0.03; // (0.05 in take 489's A)

// Four smooth noises at once: the texture's lattice, interpolated with smoothstep.
vec4 n4(vec3 x) {
    const vec3 i = floor(x), f = fract(x);
    return textureLod(noise4, (i + f * f * (3.0 - 2.0 * f) + 0.5) * (1.0 / 64.0), 0.0);
}
float n1(vec3 x) { return n4(x).r; }

// A world point in a noise's lattice of `L` metres, drifted by the smoke's clock. The drift
// is added in lattice units modulo the texture's 64-cell period, where the noise repeats
// exactly: so no time is a seam, and no clock grows large enough to lose precision (take
// 488: the world-space wrap at 65536 m was a seam that sweeps through the scene, and X4's
// clock is the save's game time, 91786 s in his).
float g_drift = 0.0; // metres, the clock times kDrift
float g_haze = kHaze; // the haze, or the layer's fog2.w (an A/B's phase) where set
vec3 at(vec3 p, float L) { return p / L + vec3(0.0, 0.0, mod(g_drift / L, 64.0)); }

// The smoke's density at a world point p, `dist` metres away, at the clock `t`, where a
// low-res pixel covers `cell` metres (X4's grid column to take 488: four times coarser, it
// faded the mottling out beyond ~800 m) and `foot` is the thinnest wisp drawn. `clear`:
// where it is 0 because no cloud can be there, how far on along any line none can start
// (the cloud test's noise changes by at most 1.5 a lattice cell: 0.65 x 1.5 / kCloud a
// metre).
float smoke(vec3 p, float t, float dist, float cell, float foot, out float clear) {
    // Clouds: the cloud test first; its second octave slides against the first (kMorph).
    const float c1 = n1(at(p, kCloud) + vec3(3.3, 7.1, 1.9));
    const float soft = max(kSoft, 0.45 * 2.5 * cell / kCloud);
    // Its second octave slides against the first: the outlines change (kMorph).
    const vec3 morph = mod(vec3(0.6, 0.5, -0.6) * (t * kMorph / (0.4 * kCloud)), 64.0);
    clear = 0.0;
    // A skip is measured against the lowest edge on its way: the edge widens with the
    // distance (no thinner than a pixel), so it is lowest at kFar.
    const float edge = kCover - max(kSoft, 0.45 * 2.5 * (cell / max(dist, 1.0)) * kFar / kCloud);
    if (0.65 * c1 + 0.35 <= edge) {
        clear = (edge - (0.65 * c1 + 0.35)) * kCloud / (0.65 * 1.5);
        return 0.0;
    }
    const float cv = 0.65 * c1 + 0.35 * n1(at(p, 0.4 * kCloud) + morph + vec3(9.1, 2.2, 5.5));
    // Both octaves under the edge (after take 490): no cloud can start before they rise by
    // the difference, at most 1.5 a lattice cell each -- 0.65 x 1.5 / kCloud + 0.35 x 1.5 /
    // (0.4 kCloud) a metre. Without this, a ray stepped plane by plane wherever the first
    // octave alone allowed a cloud: 145 evaluations a ray over eight views, 25 in a cloud;
    // with it, 94.
    if (cv <= edge) {
        clear = (edge - cv) * kCloud / (1.5 * (0.65 + 0.35 / 0.4));
        return 0.0;
    }
    const float cloud = smoothstep(kCover - soft, kCover + soft, cv);
    if (cloud <= 0.001)
        return 0.0;
    // Mottling, curled by the clouds' warp.
    const vec3 w = n4(at(p, kWarp) + vec3(5.2, 1.3, 7.7 + mod(t * kChurn, 64.0))).rgb - 0.5;
    float mot = 0.0;
    for (int k = 0; k < 2; ++k) {
        const float lam = kMottle / float(1 << k);
        const float f = smoothstep(1.0, 2.0, lam / (4.0 * 2.5 * cell));
        const float n = f > 0.0 ? n1(at(p, lam) + w * (0.8 * kWarp / lam) + float(k) * vec3(13.7, 5.1, 8.9)) : 0.5;
        mot += (k == 0 ? 0.65 : 0.35) * mix(0.5, n, f);
    }
    mot = clamp((mot - 0.5) * 2.0 + 0.5, 0.0, 1.0);
    // Wisps at four sizes, curled by their own warp, each only where it is thick enough.
    const float ws = 6.0 * kStr;
    const vec3 w2 = n4(at(p, ws) + vec3(1.7, 9.2, 3.4 + mod(-t * kChurn, 64.0))).rgb - 0.5;
    float acc = 0.0, norm = 0.0, amp = 1.0;
    for (int k = 0; k < 4; ++k) {
        const float lam = kStr * float(1 << k);
        const float fit = smoothstep(1.0, 2.0, (lam / kGain) / foot);
        float ridge = 0.0;
        if (fit > 0.0) {
            vec3 r = at(p, lam) + w2 * (kCurl * ws / lam) + float(k) * vec3(13.7, 5.1, 8.9);
            r.x /= kStretch;
            ridge = pow(clamp(1.0 - abs(n1(r) - 0.5) * kGain, 0.0, 1.0), kSharp);
        }
        acc += amp * (fit * ridge + (1.0 - fit) * g_haze);
        norm += amp;
        amp *= 0.9;
    }
    float m = acc / norm;
    m *= 0.4 + 0.6 * smoothstep(0.35, 0.65, n1(at(p, 3.0 * kStr) + vec3(3.1, 4.1, 5.9)));
    const float detail = (1.0 - kMix) + kMix * m / 0.15;
    const float near = 0.3 + 0.7 * smoothstep(40.0, 400.0, dist);
    return max(cloud * mot * near * detail, 0.0);
}

vec3 cell_view(vec3 uv) {
    const vec3 cs = vec3(uv.xy * 2.0 - 1.0, uv.z * uv.z * F_volume_scale + F_volume_off);
    const vec4 p = M_invprojection * vec4(cs, 1.0);
    return p.xyz / p.w;
}

void main() {
    const ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= kW || id.y >= kH)
        return;
    const vec2 uv = (vec2(id) + 0.5) / vec2(kW, kH);
    const vec3 t4 = M_viewinverse[3].xyz;
    const vec3 anchor = dot(t4, t4) < 1.0 ? V_cameraposition.xyz : vec3(0.0);
    const vec3 origin = t4 + anchor;
    const vec3 ray = normalize(mat3(M_viewinverse) * normalize(cell_view(vec3(uv, 0.5))));
    // A low-res pixel's width at a metre, across the middle.
    const vec3 a = cell_view(vec3(0.0, 0.5, 0.5)), b = cell_view(vec3(1.0, 0.5, 0.5));
    const float span = abs(b.x - a.x) / max(abs(a.z), 1e-6);
    const float px = span / float(kW);
    const vec4 knobs = pose.fog;
    const float far = pose.fog2.x > 0.0 ? pose.fog2.x : kFar;
    const float footpx = kFootPx * (knobs.w > 0.0 ? knobs.w : 1.0);
    const vec3 lc = max(V_lightcolor1.rgb, vec3(1e-4));
    const vec3 glow = kBright * knobs.y * pow(lc / max(max(lc.r, lc.g), lc.b), vec3(kTint));
    // The smoke's own clock (the layer's seconds, fog2.z), not X4's game time.
    const float t_ = pose.fog2.z;
    g_drift = t_ * kDrift;
    g_haze = pose.fog2.w > 0.0 ? pose.fog2.w : kHaze;
    const float sigma = kSigma * (knobs.z > 0.0 ? knobs.z : 1.0);

    vec3 light = vec3(0.0);
    float trans = 1.0;
    // The depths stored: X4's own mapping, slice k at uv.z = (k + 0.5) / kK; the nearest
    // last. Each slice holds what the ray gathered up to its distance along the ray.
    int k = kK - 1;
    float zk = length(cell_view(vec3(uv, (float(k) + 0.5) / float(kK))));
    // World-fixed sampling planes: square to the ray, at multiples of the spacing.
    const float w0 = dot(origin, ray);
    float t = 32.0;
    while (k >= 0) {
        // Store every slice the march has passed.
        while (k >= 0 && (zk <= t || t >= far || knobs.x <= 0.0 || trans < 0.01)) {
            imageStore(march_out, ivec3(id, k), vec4(light, trans));
            k--;
            if (k >= 0)
                zk = length(cell_view(vec3(uv, (float(k) + 0.5) / float(kK))));
        }
        if (k < 0)
            break;
        const float sp = max(6.0, exp2(floor(log2(max(kStepFrac * t, 1.0)))));
        // One sample a world step, wherever the depths to store fall (after take 490): they
        // split the step's light, not its sampling -- their places follow the view, the
        // steps' don't, and each split was a second full evaluation.
        const float next = (floor((w0 + t) / sp) + 1.0) * sp - w0;
        const float stp = max(next - t, 0.5);
        const float tm = t + 0.5 * stp;
        const vec3 pw = origin + ray * tm;
        float clear;
        const float d = knobs.x * smoke(pw, t_, tm,
                                        px * tm, px * footpx * tm, clear) *
                        (1.0 - smoothstep(0.6 * far, far, tm));
        if (d > 0.0) {
            // The depths inside this step take its light up to where they are.
            while (k >= 0 && zk < t + stp) {
                const float part = exp(-sigma * d * max(zk - t, 0.0));
                imageStore(march_out, ivec3(id, k), vec4(light + trans * glow * (1.0 - part), trans * part));
                k--;
                if (k >= 0)
                    zk = length(cell_view(vec3(uv, (float(k) + 0.5) / float(kK))));
            }
            const float slice = exp(-sigma * d * stp);
            light += trans * glow * (1.0 - slice);
            trans *= slice;
        }
        // No cloud within `clear` of the sample: on to the last world plane before that,
        // past depths to store too -- the loop above writes each one passed, and nothing
        // on the way adds to them (after take 490: every jump stopped at each, 9.5
        // evaluations a ray).
        const float jump = kSkip != 0 ? floor((w0 + tm + clear) / sp) * sp - w0 : 0.0;
        t = max(t + stp, jump);
    }
}
