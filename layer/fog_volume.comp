#version 450
// SPDX-License-Identifier: GPL-3.0-or-later WITH x4vrmod-linking-exception
//
// The nebula, our own (after take 474): this takes the place of X4's volume_base.comp,
// the first stage of its froxel fog, which in the shipped game writes a density of zero
// into every cell of the volume. Whatever density this writes, X4's next stages light,
// integrate and blend into the scene in its own way.
//
// X4's interface, exactly (x4vr::spv::is_x4_volume_base checks X4's module against
// it before this is put in its place): the camera block at set 1 binding 0, read only
// at the offsets below; the dynamic block at set 4 binding 0 for the output's index;
// the R16f 3D storage-image table at set 0 binding 6; 8x8x1 invocations.
//
// A cell's world position is X4's own (common.glsl's volume2view and view2world): its
// grid coordinate over the grid, xy to clip, z squared through the volume's scale and
// offset, unprojected, then the view's inverse -- plus the camera's position where the
// inverse carries none (camera-relative rendering).
//
// THE PROBE: puffs on a lattice every kCell metres, fixed in the world, only near the
// ship. X4's grid is fine near (about a metre across and 3 m deep at 100 m) and coarse
// far (70 m deep at 1 km, 175 m at 6 km), and turns with X4's camera: small puffs far
// away flicker as the head turns (take 477: "a flickering checkered pattern"). So
// they fade out by kFar metres, and their edges are soft.
#extension GL_ARB_enhanced_layouts : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, std140) uniform X4Camera {
    layout(offset = 128) mat4 M_invprojection;
    layout(offset = 512) mat4 M_viewinverse;
    layout(offset = 736) vec4 V_cameraposition;
    layout(offset = 960) vec4 V_volume_size;
    layout(offset = 1420) float F_time;
    layout(offset = 1528) float F_volume_off;
    layout(offset = 1532) float F_volume_scale;
};
layout(set = 4, binding = 0, std140) uniform X4Dynamic {
    layout(offset = 432) uint S_output_rt_idx;
};
layout(set = 0, binding = 6, r16f) uniform restrict writeonly image3D U_output_rt_decl[53306];

layout(constant_id = 0) const float kCell = 400.0;
layout(constant_id = 1) const float kRadiusIn = 40.0;
layout(constant_id = 2) const float kRadiusOut = 60.0;
layout(constant_id = 3) const float kStrength = 0.004;
layout(constant_id = 4) const float kFar = 1500.0;

void main() {
    const uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id.xy, uvec2(V_volume_size.xy))))
        return;
    const vec3 uv = vec3(id) / (V_volume_size.xyz - 1.0);
    const vec3 cs = vec3(uv.xy * 2.0 - 1.0, uv.z * uv.z * F_volume_scale + F_volume_off);
    const vec4 p = M_invprojection * vec4(cs, 1.0);
    const vec3 view = p.xyz / p.w;
    vec3 world = (M_viewinverse * vec4(view, 1.0)).xyz;
    const vec3 t = M_viewinverse[3].xyz;
    if (dot(t, t) < 1.0)
        world += V_cameraposition.xyz;
    const vec3 f = (fract(world / kCell) - 0.5) * kCell;
    const float near = 1.0 - smoothstep(0.6 * kFar, kFar, length(view));
    const float dens = kStrength * near * (1.0 - smoothstep(kRadiusIn, kRadiusOut, length(f)));
    imageStore(U_output_rt_decl[S_output_rt_idx], ivec3(id), vec4(dens, 0.0, 0.0, 0.0));
}
